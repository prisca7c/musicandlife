# ─── Database ───────────────────────────────────────────────────────────────
# NOTE: Use a UK/EU region Postgres instance in production (eu-west-2 / eu-west-1)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Redis (Upstash or self-hosted) ─────────────────────────────────────────
# TCP URL used by ioredis + BullMQ
REDIS_URL=rediss://default:token@hostname:6380
# REST credentials used by @upstash/redis (caching layer)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ─── Auth ────────────────────────────────────────────────────────────────────
# 64-char random secret for JWT signing
JWT_SECRET=change_me_64_chars
# Access token TTL (seconds). Default: 900 (15 min)
JWT_ACCESS_TTL=900
# Refresh token TTL (seconds). Default: 2592000 (30 days)
JWT_REFRESH_TTL=2592000
# Secret for cookie signing
COOKIE_SECRET=change_me_32_chars

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Music & Life <noreply@yourdomain.co.uk>

# ─── App URLs ────────────────────────────────────────────────────────────────
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
API_PORT=3001

# ─── Seed ────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@musicandlife.co.uk
SEED_ADMIN_PASSWORD=change_me

# ─── AI providers (stub at launch) ──────────────────────────────────────────
AI_TRANSCRIPTION_PROVIDER=stub
AI_ASSESSMENT_PROVIDER=stub
AI_SUMMARY_PROVIDER=stub

# ─── File storage ────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-key-id
AWS_SECRET_ACCESS_KEY=your-secret
AWS_REGION=eu-west-2
S3_BUCKET_ACTIVE=music-life-active
S3_BUCKET_ARCHIVE=music-life-archive

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development
