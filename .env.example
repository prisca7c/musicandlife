# ─── Database ───────────────────────────────────────────────────────────────
# NOTE: Use a UK/EU region Postgres instance in production (eu-west-2 / eu-west-1)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Redis (Upstash or self-hosted) ─────────────────────────────────────────
# TCP URL used by ioredis + BullMQ
REDIS_URL=rediss://default:token@hostname:6380
# REST credentials used by @upstash/redis (caching layer)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
# Recurring-lesson generation bulk-inserts real lessons on a schedule — opt in explicitly
# (e.g. only in the deployed production env), not just by running the API locally.
RECURRENCE_WORKER_ENABLED=false
# Auto-invoicing generates real invoices (and can send real emails) on a schedule — same
# opt-in rule as above.
INVOICE_SCHEDULER_ENABLED=false

# ─── Auth ────────────────────────────────────────────────────────────────────
# 64-char random secret for JWT signing
JWT_SECRET=change_me_64_chars
# Access token TTL (seconds). Default: 2592000 (30 days) — matches
# JWT_REFRESH_TTL deliberately, see the comment in apps/api/src/auth/auth.module.ts
JWT_ACCESS_TTL=2592000
# Refresh token TTL (seconds). Default: 2592000 (30 days)
JWT_REFRESH_TTL=2592000
# Secret for cookie signing
COOKIE_SECRET=change_me_32_chars

# ─── Email (Sender.net) ────────────────────────────────────────────────────────
# Find under Sender > Settings > API.
SENDER_API_KEY=your-sender-api-token
# The domain in EMAIL_FROM must be added + DNS-verified (SPF/DKIM) in Sender first.
EMAIL_FROM=Music & Life <noreply@yourdomain.co.uk>

# ─── App URLs ────────────────────────────────────────────────────────────────
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
API_PORT=3001

# ─── Seed ────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@musicandlife.co.uk
SEED_ADMIN_PASSWORD=change_me

# ─── File storage (Cloudflare R2) ────────────────────────────────────────────
# Account ID is shown on the right sidebar of any Cloudflare dashboard page.
R2_ACCOUNT_ID=your-cloudflare-account-id
# From R2 > Manage R2 API Tokens > Create API Token (scope it to your bucket).
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Bucket name you created under R2 > Create bucket.
R2_BUCKET=your-bucket-name
# Optional override — only needed if the bucket was created with an EU jurisdiction
# restriction: https://<account-id>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development
